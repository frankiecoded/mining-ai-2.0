  "soil_sampling_protocols": {
    "gold_exploration": {
      "methods": [
        {
          "name": "Ridge soil sampling",
          "spacing": "100-200m lines, 25-50m station intervals",
          "depth": "B-horizon (20-40cm below surface)",
          "sample_mass": "500g - 1kg",
          "target_anomalies": ["Au", "As", "Sb", "Bi", "Te", "W"],
          "background_levels": {
            "Au_ppb": "<5",
            "As_ppm": "<10",
            "Sb_ppm": "<2",
            "Bi_ppm": "<0.5"
          },
          "anomaly_thresholds": {
            "Au_ppb": ">20",
            "As_ppm": ">50",
            "Sb_ppm": ">5",
            "Bi_ppm": ">2"
          }
        },
        {
          "name": "Stream sediment sampling",
          "spacing": "1 catchment per 2-5 km²",
          "depth": "Below organic layer, 20-40cm",
          "sample_mass": "2-5kg (bulk), <2mm fraction analyzed",
          "target_anomalies": ["Au", "Ag", "As", "Sb", "Cu", "Zn"],
          "analysis_methods": ["Fire assay (Au)", "ICP-MS (multi-element)", "Atomic absorption (individual elements)"]
        },
        {
          "name": "Auger soil sampling",
          "spacing": "50-100m grid",
          "depth": "0.5-2m",
          "sample_mass": "1-2kg",
          "target": "Laterite and saprolite profiles",
          "best_for": "Tropical laterite gold deposits (common in East Africa)"
        }
      ],
      "chemical_indicators": {
        "primary_pathfinder_elements": ["As", "Sb", "Bi", "Te", "W"],
        "secondary_pathfinder_elements": ["Ag", "Cu", "Zn", "Pb", "Mo"],
        "indicator_minerals": ["Pyrite", "Arsenopyrite", "Stibnite", "Bismuthinite", "Tellurides"],
        "alteration_signatures": ["Silicification", "Sericitization", "Chloritization", "Albitization"]
      },
      "geophysical_signatures": {
        "IP_chargeability": ">20 mV/V (massive sulfide associated gold)",
        "resistivity": "Low resistivity may indicate alteration zones",
        "magnetic": "Magnetic lows can indicate alteration destroying magnetite",
        "EM_conductors": "May indicate sulfide-rich zones"
      }
    },
    "diamond_exploration": {
      "methods": [
        {
          "name": "Heavy mineral sampling",
          "target": "Kimberlite indicator minerals (KIMs)",
          "minerals": ["Garnet (G10/G9)", "Pyroxene (chrome diopside)", "Ilmenite", "Spinel"],
          "sample_size": "20-50kg bulk sample",
          "processing": "Dense media separation; hand picking under microscope"
        },
        {
          "name": "Till sampling",
          "spacing": "Glacial till geochemistry",
          "target": "KIMs, diamond microdiamonds",
          "analysis": "Microdiamond counts, indicator mineral chemistry"
        },
        {
          "name": "Microdiamond sampling",
          "method": "Caustic dissolution of kimberlite",
          "sample_mass": "10-100kg",
          "purpose": "Early assessment of diamond potential"
        }
      ],
      "indicator_mineral_chemistry": {
        "chrome_garnet_G10": {
          "Cr2O3": ">1.5%",
          "CaO": "<1.0%",
          "MgO": ">20%",
          "temperature_C": "900-1100 (xenocrystic from mantle)"
        },
        "chrome_diopside": {
          "Cr2O3": ">0.5%",
          "TiO2": "<0.3%",
          "color": "Bright green"
        },
        "ilmenite": {
          "Cr2O3": ">3%",
          "MgO": ">5%",
          "FeO_total": "<35%",
          "MnO": "<0.5%"
        }
      },
      "kimberlite_geochemistry": {
        "major_elements": ["SiO2 30-40%", "MgO 20-30%", "Al2O3 2-5%", "Fe2O3 5-10%"],
        "trace_elements": ["Ni >1000 ppm", "Cr >1000 ppm", "Co >100 ppm", "Nb >200 ppm"],
        "radiometric": "High K and U in groundmass; Th/K ratio diagnostic"
      }
    },
