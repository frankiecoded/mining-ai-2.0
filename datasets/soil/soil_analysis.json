    "rare_earth_exploration": {
      "methods": [
        {
          "name": "Stream sediment geochemistry",
          "target_elements": ["La", "Ce", "Nd", "Y", "Nb", "Zr", "Th", "U"],
          "anomaly_thresholds": {
            "La_ppm": ">100",
            "Ce_ppm": ">200",
            "Nd_ppm": ">50",
            "Y_ppm": ">50",
            "Th_ppm": ">30",
            "U_ppm": ">10"
          }
        },
        {
          "name": "Rock chip sampling",
          "target": "Outcrop exposures of pegmatites, carbonatites, alkaline rocks",
          "analysis": "XRF portable + lab ICP-MS"
        }
      ],
      "target_rock_types": ["Carbonatites", "Alkaline complexes", "Phosphorite", "Heavy mineral sands", "Ion-adsorption clays"],
      "indicator_minerals": ["Monazite", "Xenotime", "Bastnasite", "Allanite", "Apatite", "Zircon"],
      "radiometric_signature": "High gamma counts; K, U, Th enrichment; U/Th ratio varies by deposit type"
    }
