# =====================================================
# AI OS - Hugging Face Space Secrets
#
# 1. Copy this file to hf.secrets.env
# 2. Fill in your REAL values (same as your local .env)
# 3. Run: ./hf_deploy.sh <your-hf-username> <space-name>
#
# This file is gitignored. NEVER commit it.
# =====================================================

# --- Backend runtime ----------------------------------
ENVIRONMENT=production
API_KEY=<generate-a-long-random-string>
SECRET_KEY=<generate-another-long-random-string>
BASE_URL=https://<username>-aios-worker.hf.space

# --- WhatsApp Cloud API -------------------------------
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- PostgreSQL (Supabase OR Neon - any Postgres works) --
# Supabase: use the "Session pooler" or "Direct" connection string
# from Project Settings -> Database -> Connection string.
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# --- Qdrant (Cloud) ------------------------------------
QDRANT_URL=https://<cluster>.qdrant.io
QDRANT_API_KEY=

# --- MinIO / S3-compatible storage ---------------------
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=ai-os-storage

# --- External search ------------------------------------
SERPER_API_KEY=

# --- LLM: Hugging Face Inference Providers --------------
# OpenAI-compatible router (tool-calling supported).
LOCAL_LLM_URL=https://router.huggingface.co/v1
LOCAL_LLM_MODEL=openai/gpt-oss-120b
LOCAL_LLM_API_KEY=hf_<your-hf-write-token>
MOCK_LLM=false
