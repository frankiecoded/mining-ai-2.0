# Frontend configuration — copy this file to `.env` (local dev) and set the
# same values in the Vercel dashboard (Settings → Environment Variables) for
# production.

# The API link — this is the ONLY thing that connects the web UI to your backend.
#   Local dev backend:   VITE_API_URL=http://localhost:8000
#   Server IP (no tunnel): http://192.168.100.25:8000
#   After Cloudflare tunnel: https://aios-api.<your-domain>  (auto-written by deployment/cloudflared_setup.sh)
VITE_API_URL=http://localhost:8000

# Optional — API key for protected backend routes (sessions, telemetry, uploads).
# Must exactly match API_KEY in the backend .env. Leave empty if the backend has no key set.
VITE_API_KEY=
