# ==================================================
# AI Mining OS - Environment Configuration
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==================================================

# API Gateway Config
PORT=8000
HOST=0.0.0.0
API_KEY=
SECRET_KEY=
ENVIRONMENT=development
DEBUG=false

# WhatsApp Cloud API credentials
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# PostgreSQL DB Config
DATABASE_URL=

# Qdrant Vector DB Config
# Local: QDRANT_HOST + QDRANT_PORT. Cloud: set QDRANT_URL + QDRANT_API_KEY (overrides host/port)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=

# Redis Cache/Broker Config
REDIS_URL=redis://localhost:6379/0

# MinIO/Object Storage Config
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=ai-os-storage

# Local LLM endpoint (Ollama / vLLM / any OpenAI-compatible API)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b
# Optional bearer token for hosted OpenAI-compatible endpoints (Groq, OpenRouter, Together, OpenAI)
LOCAL_LLM_API_KEY=
MOCK_LLM=false

# Embedding Model (runs locally, free)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# External Search Service (for Research agent fallback)
SERPER_API_KEY=

# GCP GCE VM Manager Config (For On-Demand GPU instance)
GCP_PROJECT=
GCP_ZONE=
GCP_INSTANCE_NAME=
GPU_IDLE_TIMEOUT_MINUTES=5

# CORS - Comma-separated allowed origins (never use * in production)
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WEBHOOK_PER_MINUTE=30

# Base URL for generated links
BASE_URL=http://localhost:8000

# Processing mode
# sync  = process WhatsApp webhook inline (local dev, default)
# queue = enqueue messages to wa_inbox; run `python -m backend.worker` to process on demand
PROCESSING_MODE=sync
WORKER_POLL_INTERVAL=3
WORKER_BATCH_SIZE=5
WORKER_MAX_ATTEMPTS=3
# Idle self-improvement: runs analytics synthesis, conversation mining and Q&A
# generation when the inbox is empty so the system gets smarter over time.
WORKER_IDLE_TASKS=true
IDLE_TASK_BUDGET_SECONDS=6
