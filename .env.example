# ==================================================
# AI Mining OS - Local Server Configuration
# ==================================================
PORT=8000
HOST=0.0.0.0
API_KEY=
SECRET_KEY=
ENVIRONMENT=development
DEBUG=true

# --- Local LLM (Ollama running on your machine) ---
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_LLM_API_KEY=
MOCK_LLM=true

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- External Search (optional) ---
SERPER_API_KEY=

# --- CORS (add your Vercel frontend URL and Cloudflare tunnel URL here) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Base URL (set to your public Cloudflare URL after tunnel setup, e.g. https://aios-api.your-domain.com) ---
BASE_URL=http://localhost:8000

# --- Local Storage (leave blank to auto-detect) ---
STORAGE_LOCAL_DIR=

# --- Token Conservation (all budgets are estimated tokens ~ chars/4) ---
# Total context budget per LLM call (history is rolled up; system sections capped).
TOKEN_CONTEXT_BUDGET=6000
# Output cap sent as max_tokens for completions (0 = server default).
TOKEN_MAX_OUTPUT=1024
# Max tool-call rounds per user message.
TOKEN_MAX_ROUNDS=8
# RAG breadth + snippet cap injected into the system prompt.
TOKEN_RAG_LIMIT=12
TOKEN_RAG_SNIPPET_CHARS=800
# Compact dataset index chars injected (0 = skip entirely; saves ~5.5K tok/msg).
TOKEN_DIGEST_CHARS=6000
# Recent turns loaded from DB when resuming a session (2 messages per turn).
TOKEN_HISTORY_TURNS=40
# Fact-extraction LLM gate: min message chars + min seconds between calls per session.
TOKEN_FACT_MIN_CHARS=20
TOKEN_FACT_MIN_INTERVAL_S=60
# RAG/query-context cache TTL (seconds) — repeated questions skip re-POSTs.
TOKEN_CACHE_TTL_S=300
# Skip the 31-tool schema for casual/greeting messages (saves ~6.4K tok/msg).
TOKEN_LITE_TOOLS=true
